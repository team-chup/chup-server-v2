# deploy/.env 로 복사한 뒤 실제 값을 채워서 chup-prod VM에 둡니다. (.env 는 git에 커밋하지 않습니다)
# 이 값들은 GitHub Actions(thup-prod-cd.yml)의 PROD_* Secrets로도 동일하게 등록해야 합니다.

MYSQL_PASSWORD=
REDIS_PASSWORD=

DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
# DataGSM 상용 OAuth 앱에 등록해야 하는 콜백 URL. compose.prod.yml에 리터럴로 고정되어 있어
# 여기서는 값을 채우지 않아도 되지만, 앱 등록 시 정확히 이 값과 일치해야 함:
# https://api.chup.site:34046/api/auth/datagsm/callback

# Resend(https://resend.com) API 키. 미설정 시 이메일 발송은 조용히 건너뜀
RESEND_API_KEY=
# Resend에 인증된 발신 도메인 이메일
MAIL_FROM_ADDRESS=

# TLS 인증서(ZeroSSL DNS-01 수동 발급, dev와 동일 방식)를 아래 파일명으로 deploy/certs/에 배치:
#   deploy/certs/api-fullchain.cer
#   deploy/certs/api.chup.site.key
