# deploy/.env 로 복사한 뒤 실제 값을 채워서 VM에 둡니다. (.env 는 git에 커밋하지 않습니다)

MYSQL_PASSWORD=
REDIS_PASSWORD=

DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
# GSMSV VM에 할당된 HTTP 포트 기준으로 DataGSM 클라이언트에 등록한 콜백 URL과 정확히 일치해야 함
DATAGSM_REDIRECT_URI=http://ssh.gsmsv.site:<HTTP_PORT>/api/auth/datagsm/callback

# 배포된 프론트엔드 도메인으로 교체
OAUTH_SUCCESS_REDIRECT_URL=
OAUTH_FAILURE_REDIRECT_URL=