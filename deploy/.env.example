# deploy/.env 로 복사한 뒤 실제 값을 채워서 VM에 둡니다. (.env 는 git에 커밋하지 않습니다)

MYSQL_PASSWORD=
REDIS_PASSWORD=

DATAGSM_CLIENT_ID=
DATAGSM_CLIENT_SECRET=
# 세션 쿠키가 Secure+SameSite=None이라 반드시 Caddy(443, 자체 서명 인증서)를 거친 https 주소여야 함.
# GSMSV VM에 할당된 HTTPS 포트 기준으로 DataGSM 클라이언트에 등록한 콜백 URL과 정확히 일치해야 함
DATAGSM_REDIRECT_URI=https://ssh.gsmsv.site:<HTTPS_PORT>/api/auth/datagsm/callback
# oauth.datagsm.allowed-redirect-origins 등 redirectOrigin 관련 설정은 application.yml의
# 기본값(OAUTH_ALLOWED_REDIRECT_ORIGINS 등 환경변수, 미설정 시 localhost:3000/3001)을 그대로 쓴다.
# CORS_ALLOWED_ORIGINS와 동일하게 여기 .env/compose에는 의도적으로 배선하지 않음 —
# 시크릿 미설정 시 빈 문자열이 주입되어 Spring 기본값을 덮어쓰고 앱이 부팅 실패하는 것을 방지하기 위함.

# Resend(https://resend.com) API 키. 미설정 시 이메일 발송은 조용히 건너뜀
RESEND_API_KEY=
# Resend에 인증된 발신 도메인 이메일. 도메인 인증 전에는 onboarding@resend.dev로 본인 계정 이메일에만 발송 가능
MAIL_FROM_ADDRESS=